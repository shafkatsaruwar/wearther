{
  "expo": {
    "name": "Steady",
    "slug": "steady-habit-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "steady",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E8F0EA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.steady.habits",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "CFBundleDisplayName": "Steady"
      }
    },
    "android": {
      "package": "com.steady.habits",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E8F0EA"
      },
      "icon": "./assets/icon.png"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#E8F0EA"
    },
    "plugins": []
  }
}
